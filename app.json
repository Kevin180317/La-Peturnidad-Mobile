{
  "expo": {
    "name": "Lucky Tracker",
    "slug": "la-peturnidad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lapeturnidad",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.idarko.lapeturnidad",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#faf5e0"
      },
      "package": "com.idarko.lapeturnidad",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf5e0"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lucky Tracker necesita acceso a tus fotos para subir imágenes de tus mascotas y publicaciones.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6e9e77a-c1aa-41f3-8b1a-4902bc4bac78"
      }
    },
    "owner": "idarko"
  }
}
